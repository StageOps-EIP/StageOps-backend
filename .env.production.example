# Domaine public pointant vers le VPS (enregistrement DNS A/AAAA).
API_DOMAIN=api.example.com

# Origines autorisées à appeler l'API, séparées par des virgules.
CORS_ORIGINS=https://app.example.com

# Identifiants internes CouchDB. Ne jamais exposer CouchDB sur Internet.
COUCHDB_DB=stageops
COUCHDB_AUTH_DB=stageops_auth
COUCHDB_USER=stageops_admin
COUCHDB_PASSWORD=replace-with-at-least-32-random-characters

# Secret HS256 de 32 caractères minimum.
JWT_SECRET=replace-with-at-least-32-random-characters
USER_ID_SECRET=replace-with-another-32-character-secret
JWT_ISSUER=stageops-api
JWT_AUDIENCE=stageops-clients
DEFAULT_THEATRE_ID=replace-with-theatre-id

# Vérification des comptes par email (STARTTLS obligatoire par défaut).
AUTH_REQUIRE_EMAIL_VERIFICATION=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=noreply@stageops.example.com
SMTP_IMPLICIT_TLS=false
AUTH_VERIFICATION_URL=https://app.stageops.example.com/verify-email

# Premier régisseur général. Retirer ces deux variables après le premier
# déploiement réussi, puis relancer deploy.sh.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-Strong-Admin-Password-42!

# Garder false tant que l'inscription n'est pas limitée à un théâtre.
ALLOW_PUBLIC_REGISTRATION=false

# Limites Docker adaptées à un petit VPS. À ajuster après mesure.
BACKEND_CPUS=1.0
BACKEND_MEMORY=512m
COUCHDB_CPUS=1.0
COUCHDB_MEMORY=1g
