COUCHDB_URL=http://localhost:5984
COUCHDB_DB=stageops
COUCHDB_AUTH_DB=stageops_auth
COUCHDB_USER=stageops
COUCHDB_PASSWORD=change-me
# 32 caractères minimum. Générer avec: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters
USER_ID_SECRET=replace-with-another-32-character-secret
JWT_ISSUER=stageops-api
JWT_AUDIENCE=stageops-clients
DEFAULT_THEATRE_ID=theatre-demo
# Générer avec: openssl rand -base64 32
OFFLINE_SIGNING_KEY=replace-with-base64-encoded-32-byte-seed
OFFLINE_KEY_ID=offline-2026-01
OFFLINE_AUDIENCE=stageops-offline
APP_PORT=3000
CORS_ORIGINS=http://localhost:8080
ALLOW_PUBLIC_REGISTRATION=true
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# Obligatoire si AUTH_REQUIRE_EMAIL_VERIFICATION=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_IMPLICIT_TLS=false
AUTH_VERIFICATION_URL=https://localhost/verify-email
# TLS_CERT=/run/secrets/tls.crt
# TLS_KEY=/run/secrets/tls.key
