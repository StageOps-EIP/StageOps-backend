COUCHDB_URL=http://localhost:5984
COUCHDB_DB=stageops
COUCHDB_AUTH_DB=stageops_auth
COUCHDB_USER=stageops
COUCHDB_PASSWORD=change-me
# 32 caractères minimum. Générer avec: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters
USER_ID_SECRET=replace-with-another-32-character-secret
JWT_ISSUER=stageops-api
JWT_AUDIENCE=stageops-clients
DEFAULT_THEATRE_ID=theatre-demo
APP_PORT=3000
CORS_ORIGINS=http://localhost:8080
ALLOW_PUBLIC_REGISTRATION=true
# TLS_CERT=/run/secrets/tls.crt
# TLS_KEY=/run/secrets/tls.key
